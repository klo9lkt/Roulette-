// 입력한 지역명에 맞는 격자좌표를 찾음 (정확히 같은 이름 우선, '안동'처럼 시/군 글자 없는 입력도 허용)
function findGrid(region) {
  var name = String(region || '').replace(/\s/g, '');
  if (!name) return null;
  var best = null;
  GRID_TEXT.split(';').forEach(function (e) {
    var p = e.split(':'), k = p[0];
    if (best && best.exact) return;
    var exact = (k === name);
    var hit = exact || name.indexOf(k) >= 0 || k.indexOf(name) === 0;
    if (hit && (exact || !best || (!best.exact && k.length > best.key.length))) {
      var xy = p[1].split(',');
      best = { key: k, nx: Number(xy[0]), ny: Number(xy[1]), exact: exact };
    }
  });
  return best;
}

// 웹앱 첫 화면
function doGet() {
  return HtmlService.createHtmlOutputFromFile('index')
    .setTitle('날씨 점심 룰렛')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

// 화면에서 호출하는 함수: 지역명을 받아 날씨 정보를 돌려줍니다.
function getWeather(region) {
  try {
    var g = findGrid(region);
    if (!g) return { ok: false, error: '찾을 수 없는 지역이에요: ' + region + ' (예: 안동시, 영주시, 수원시)' };

    var apiKey = PropertiesService.getScriptProperties().getProperty('KMA_KEY');
    if (!apiKey) return { ok: false, error: '스크립트 속성에 KMA_KEY가 없어요.' };
    try { apiKey = decodeURIComponent(apiKey); } catch (e) {}

    // 발표는 매시 30분, 제공은 약 45분 이후 → 45분 전 시각 기준으로 base_time 결정
    var t = new Date(Date.now() - 45 * 60 * 1000);
    var baseDate = Utilities.formatDate(t, 'Asia/Seoul', 'yyyyMMdd');
    var baseTime = Utilities.formatDate(t, 'Asia/Seoul', 'HH') + '30';

    var url = KMA_URL + '?serviceKey=' + encodeURIComponent(apiKey) +
      '&pageNo=1&numOfRows=100&dataType=JSON&base_date=' + baseDate +
      '&base_time=' + baseTime + '&nx=' + g.nx + '&ny=' + g.ny;
    var res = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    var body = res.getContentText();

    var json;
    try { json = JSON.parse(body); }
    catch (e) { return { ok: false, error: '기상청 응답을 해석하지 못했어요: ' + body.slice(0, 120) }; }

    var head = json.response.header;
    if (head.resultCode !== '00') {
      return { ok: false, error: '기상청 오류 ' + head.resultCode + ': ' + head.resultMsg };
    }

    // 항목(T1H 기온, SKY 하늘, PTY 강수형태)마다 가장 이른 예보시각 값을 고름
    var items = json.response.body.items.item;
    var pick = {};
    items.forEach(function (it) {
      var cur = pick[it.category];
      if (!cur || it.fcstTime < cur.fcstTime) pick[it.category] = it;
    });
    if (!pick.T1H || !pick.SKY || !pick.PTY) return { ok: false, error: '필요한 예보 항목이 없어요.' };

    var sky = { '1': '맑음', '3': '구름많음', '4': '흐림' }[pick.SKY.fcstValue] || '알 수 없음';
    var pty = { '0': '없음', '1': '비', '2': '비/눈', '3': '눈', '5': '빗방울', '6': '빗방울/눈날림', '7': '눈날림' }[pick.PTY.fcstValue] || '알 수 없음';
    var ft = pick.T1H.fcstTime;

    return {
      ok: true, region: g.key, time: ft.slice(0, 2) + ':' + ft.slice(2),
      temp: Number(pick.T1H.fcstValue), sky: sky, pty: pty
    };
  } catch (err) {
    return { ok: false, error: String(err) };
  }
}

// 서버 테스트용: 편집기에서 실행하고 [실행 로그]를 확인하세요.
function testWeather() {
  var r = getWeather('영주시');
  Logger.log('ok: ' + r.ok);
  Logger.log(JSON.stringify(r));
}
